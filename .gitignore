# Local IDE/session state
.Rproj.user/

# Generated diagrams and binary presentation artifacts
mermaid-diagram.png
02_IMPLEMENTATION_MASTERS/*.html
02_IMPLEMENTATION_MASTERS/*.pdf

# Logs, caches, and temporary outputs
*.log
*.tmp
*.temp
*.bak
*.swp
*~
.cache/
__pycache__/

# External retrieval clones are documented in manifests/lockfile, not vendored.
04_RETRIEVAL_CONTEXT/EXTERNAL_REPOS/R/*/
04_RETRIEVAL_CONTEXT/EXTERNAL_REPOS/STATA/*/

# Keep curated external retrieval metadata tracked.
!04_RETRIEVAL_CONTEXT/EXTERNAL_REPOS/EXTERNAL_REPO_MANIFEST.md
!04_RETRIEVAL_CONTEXT/EXTERNAL_REPOS/EXTERNAL_REPO_RETRIEVAL_RULES.md
!04_RETRIEVAL_CONTEXT/EXTERNAL_REPOS/EXTERNAL_REPO_NOTES.md
